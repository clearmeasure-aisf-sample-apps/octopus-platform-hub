name = "Deploy - Production database change has a restore point"
description = "A production deployment of the demo systems (spaces whose slug ends in -demo), of the systems cmfleet and jpcom (spaces cmfleet and jeffreypalermo-sites) or of the bootcamp (space churchbulletin) that changes a database schema (step migrate-database or run-db-migrations, or the process template kit-migrate-database) records a restore point first (step record-restore-point, or the process template kit-record-restore-point), finished before the first change. Steps that change data but not the schema (for example Set employee middle names, Initialize database) are not database changes (decision 2026-10-05). Warn mode first (decision D5). No space is exempt: cmdemo3, once exempt, records a restore point since cmdemo3-system #14."
violation_action = "warn"
violation_reason = "A production database change needs a restore point recorded before it."

conditions {
    rego = <<-EOT
            package prod_db_change_has_restore_point

            # Octopus accepts no user-defined functions in a policy ("User-defined functions are not supported", at the first
            # publish on 2026-10-07): every rule here is a value, a set or an array, and each result has a body of its own.

            # Warn first everywhere (decision D5). The -demo spaces move to block after two clean weeks (plan phase 7).
            violation_action := "warn"

            # No space is exempt (decision D5): cmdemo3, exempt at first because SQL Server Express in its cluster has no
            # point-in-time restore, records a verified backup before every prod deployment since cmdemo3-system #14
            # (exemption removed 2026-10-05). To exempt a space again, add an exemptions map with its reason and a result
            # for it, as prod_has_sign_off does.

            # Steps that change a database schema, by step slug: the kit's "Migrate database" and the bootcamp's DbUp
            # step "Run DB migrations"; or any step of the process template kit-migrate-database (plan section 5.2).
            # Steps that change data but not the schema (Set employee middle names, Initialize database, Seed demo
            # employees) are not database changes here (decision 2026-10-05).
            database_change_slugs := {"migrate-database", "run-db-migrations"}

            database_change_templates := {"kit-migrate-database"}

            # Steps that record a restore point: the kit's "Record restore point", or the template kit-record-restore-point.
            restore_point_slugs := {"record-restore-point"}

            restore_point_templates := {"kit-record-restore-point"}

            default result := {"allowed": false, "action": "warn", "reason": "A production database change needs a restore point recorded before it."}

            result := {"allowed": true, "reason": "No database change runs in this deployment."} if {
            	count(changes) == 0
            }

            result := {"allowed": true} if {
            	count(changes) > 0
            	protected
            }

            result := {"allowed": false, "action": violation_action, "reason": violation_reason} if {
            	count(changes) > 0
            	not protected
            }

            database_change_ids contains step.Id if {
            	some step in input.Steps
            	step.Slug in database_change_slugs
            }

            database_change_ids contains step.Id if {
            	some step in input.Steps
            	step.Source.Type == "Process Template"
            	step.Source.SlugOrId in database_change_templates
            }

            restore_point_ids contains step.Id if {
            	some step in input.Steps
            	step.Slug in restore_point_slugs
            }

            restore_point_ids contains step.Id if {
            	some step in input.Steps
            	step.Source.Type == "Process Template"
            	step.Source.SlugOrId in restore_point_templates
            }

            # A step runs in this deployment when it is enabled and not skipped.
            running_ids contains step.Id if {
            	some step in input.Steps
            	step.Enabled
            	not step.Id in input.SkippedSteps
            }

            # Positions in input.Steps (the process order) of the database changes and restore points that run.
            changes := [i |
            	some i, step in input.Steps
            	step.Id in database_change_ids
            	step.Id in running_ids
            ]

            restore_points := [i |
            	some i, step in input.Steps
            	step.Id in restore_point_ids
            	step.Id in running_ids
            ]

            first_change := min(changes)

            # A restore point protects the change when it comes first and has finished before the change starts.
            protected if {
            	some i in restore_points
            	i < first_change
            	not i in starts_with_the_change
            }

            # The restore points that have not finished when the first change starts: their execution group is an earlier one
            # than the change's, and no group after it, up to and including the change's, waits for the steps before it
            # (StartAfterPrevious), so the two start together.
            starts_with_the_change contains i if {
            	some i in restore_points
            	some group_a, execution_a in input.Execution
            	input.Steps[i].Id in execution_a.Steps
            	some group_b, execution_b in input.Execution
            	input.Steps[first_change].Id in execution_b.Steps
            	group_a < group_b
            	waits := [g |
            		some g, execution in input.Execution
            		g > group_a
            		g <= group_b
            		execution.StartTrigger == "StartAfterPrevious"
            	]
            	count(waits) == 0
            }

            restore_point_steps := [step |
            	some step in input.Steps
            	step.Id in restore_point_ids
            ]

            change := input.Steps[first_change].Slug

            violation_reason := sprintf("Step %s changes the database with no restore point before it: add the step record-restore-point or the process template kit-record-restore-point before the first database change.", [change]) if {
            	count(restore_point_steps) == 0
            }

            violation_reason := sprintf("Step %s changes the database, but its restore point does not run: %s.", [change, concat("; ", not_running)]) if {
            	count(restore_point_steps) > 0
            	count(restore_points) == 0
            }

            violation_reason := sprintf("Step %s changes the database before the restore point (%s) has finished.", [change, concat(", ", [input.Steps[i].Slug | some i in restore_points])]) if {
            	count(restore_point_steps) > 0
            	count(restore_points) > 0
            }

            # Why each restore point does not run: disabled, or else skipped in this deployment.
            disabled_ids contains step.Id if {
            	some step in restore_point_steps
            	not step.Enabled
            }

            state_word := {true: "disabled", false: "skipped"}

            not_running := [reason |
            	some step in restore_point_steps
            	disabled := step.Id in disabled_ids
            	reason := sprintf("step %s is %s", [step.Slug, state_word[disabled]])
            ]
            EOT
}

scope {
    rego = <<-EOT
            package prod_db_change_has_restore_point

            # Deployments to prod in the spaces of the kit's demo systems (the kit names each space "<slug> demo", so
            # its slug ends in -demo), of the fleet's two systems named below and in the bootcamp's space ChurchBulletin.
            # Runbook runs are out of scope, and so is every other space of the instance.
            default evaluate := false

            evaluate if {
            	not input.Runbook
            	input.Environment.Slug == "prod"
            	in_scope_space
            }

            # The systems of the fleet whose space has another name, by the slug of that space: cmfleet (the fleet health
            # dashboard) and jeffreypalermo-sites (jpcom; its space is "JeffreyPalermo - Sites"). A space joins by name here.
            fleet_spaces := {"cmfleet", "jeffreypalermo-sites"}

            in_scope_space if endswith(input.Space.Slug, "-demo")

            in_scope_space if input.Space.Slug in fleet_spaces

            in_scope_space if input.Space.Slug == "churchbulletin"
            EOT
}

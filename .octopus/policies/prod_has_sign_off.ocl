name = "Deploy - Production has a sign-off"
description = "Every production deployment of the demo systems (spaces whose slug ends in -demo) and of the bootcamp (space churchbulletin) runs a sign-off: an enabled, not skipped manual intervention (Octopus.Manual) or a step of the process template cmdemo-process-template. Warn mode first (decision D5). Exempt: the bootcamp, which has no Octopus approval by design."
violation_action = "warn"
violation_reason = "A production deployment needs a sign-off that runs: an enabled manual intervention (Octopus.Manual) or the cmdemo-process-template process template, not skipped."

conditions {
    rego = <<-EOT
            package prod_has_sign_off

            # Octopus accepts no user-defined functions in a policy ("User-defined functions are not supported", at the first
            # publish on 2026-10-07): every rule here is a value, a set or an array, and each result has a body of its own.

            # Warn first everywhere (decision D5). The -demo spaces move to block after two clean weeks (plan phase 7).
            violation_action := "warn"

            # Spaces exempt from this policy, each with its reason (decision D5, 2026-10-05).
            exemptions := {"churchbulletin": "the bootcamp has no Octopus approval by design: its master builds reach Prod after the TDD acceptance tests and the GitHub environment wait timers."}

            default result := {"allowed": false, "action": "warn", "reason": "A production deployment needs a sign-off that runs."}

            result := {"allowed": true} if {
            	has_running_sign_off
            }

            result := {"allowed": true, "reason": concat("", ["Exempt: ", exemptions[input.Space.Slug]])} if {
            	not has_running_sign_off
            	exemptions[input.Space.Slug]
            }

            result := {"allowed": false, "action": violation_action, "reason": violation_reason} if {
            	not has_running_sign_off
            	not exemptions[input.Space.Slug]
            }

            # A sign-off: a manual intervention, or a step of the process template cmdemo-process-template.
            sign_off_ids contains step.Id if {
            	some step in input.Steps
            	step.ActionType == "Octopus.Manual"
            }

            sign_off_ids contains step.Id if {
            	some step in input.Steps
            	step.Source.Type == "Process Template"
            	step.Source.SlugOrId == "cmdemo-process-template"
            }

            # The sign-offs in the order of the process.
            sign_off_steps := [step |
            	some step in input.Steps
            	step.Id in sign_off_ids
            ]

            # A step runs in this deployment when it is enabled and not skipped.
            running_sign_offs := [step.Slug |
            	some step in sign_off_steps
            	step.Enabled
            	not step.Id in input.SkippedSteps
            ]

            has_running_sign_off if count(running_sign_offs) > 0

            violation_reason := "No sign-off in this production deployment: add an enabled manual intervention (Octopus.Manual) or the cmdemo-process-template process template." if {
            	count(sign_off_steps) == 0
            }

            violation_reason := sprintf("The sign-off of this production deployment does not run: %s.", [concat("; ", not_running)]) if {
            	count(sign_off_steps) > 0
            }

            # Why each sign-off does not run: disabled, or else skipped in this deployment.
            disabled_ids contains step.Id if {
            	some step in sign_off_steps
            	not step.Enabled
            }

            state_word := {true: "disabled", false: "skipped"}

            not_running := [reason |
            	some step in sign_off_steps
            	disabled := step.Id in disabled_ids
            	reason := sprintf("step %s is %s", [step.Slug, state_word[disabled]])
            ]
            EOT
}

scope {
    rego = <<-EOT
            package prod_has_sign_off

            # Deployments to prod in the spaces of the kit's demo systems (the kit names each space "<slug> demo", so
            # its slug ends in -demo) and in the bootcamp's space ChurchBulletin. Runbook runs are out of scope.
            default evaluate := false

            evaluate if {
            	not input.Runbook
            	input.Environment.Slug == "prod"
            	in_scope_space
            }

            in_scope_space if endswith(input.Space.Slug, "-demo")

            in_scope_space if input.Space.Slug == "churchbulletin"
            EOT
}
